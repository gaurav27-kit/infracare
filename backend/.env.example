# ═══════════════════════════════════════════════════════════════════════════════
# InfraCare Backend — Production Environment Template (.env.example)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server Configuration ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# ─── Database (PostgreSQL / Prisma) ───────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
# Example for local/Docker: postgresql://postgres:postgres@localhost:5432/smart_campus_fix?schema=public
# Example for Cloud (Render/Railway/Supabase): postgresql://USER:PASS@HOST:5432/DB?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_campus_fix?schema=public"

# ─── CORS / Allowed Origins ───────────────────────────────────────────────────
# Comma-separated list of allowed web origins, or * for open access.
# Note: Mobile requests (Flutter) without origin headers are automatically allowed.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Cloudinary Credentials (For Issue Image Attachments) ─────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
