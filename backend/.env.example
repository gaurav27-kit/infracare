# ═══════════════════════════════════════════════════════════════════════════════
# InfraCare Backend — Environment Template (.env.example)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server Configuration ──────────────────────────────────────────────────────
PORT=5050
NODE_ENV=development
LOG_LEVEL=info

# ─── Database (PostgreSQL / Prisma) ───────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
# Example for local/Docker: postgresql://postgres:postgres@localhost:5432/infracare?schema=public
# Example for Cloud (Render/Railway/Supabase pooler): postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/infracare?schema=public"
# Direct connection for migrations (bypasses connection poolers like PgBouncer)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/infracare?schema=public"

# ─── CORS / Allowed Origins ───────────────────────────────────────────────────
# Comma-separated list of allowed web origins, or * for open access.
# Note: Mobile requests (Flutter) without origin headers are automatically allowed.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# ─── Cloudinary Credentials (For Issue Image Attachments) ─────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=infracare/issues
